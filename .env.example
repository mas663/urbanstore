# ─────────────────────────────────────────────
# UrbanStore — Environment Variables
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit file .env ke Git.
# ─────────────────────────────────────────────

PORT=3001

# Lokasi database SQLite (dibuat otomatis + diisi data contoh)
DATABASE_PATH=./data/urbanstore.db

# Akun Store Admin awal (dibuat otomatis saat database pertama kali dibuat)
ADMIN_EMAIL=admin@urbanstore.id
ADMIN_PASSWORD=ganti-password-ini

# Rekening tujuan transfer manual (tampil di halaman invoice)
STORE_BANK_NAME=BCA
STORE_BANK_ACCOUNT=123-456-7890
STORE_BANK_HOLDER=PT UrbanStore Fashion Indonesia

# ── AI (Sesi 5) ──────────────────────────────
# Pilih provider: gemini | openai_compatible
#   gemini            → langsung ke Gemini API (Google AI Studio)
#   openai_compatible → lewat AI router seperti 9Router (endpoint OpenAI-compatible)
AI_PROVIDER=gemini

# Ambil API key di https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Dipakai hanya jika AI_PROVIDER=openai_compatible (mis. 9Router)
# Isi sesuai URL & key dari dashboard router kamu.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Batas pemakaian AI Shopping Assistant per customer
CHAT_QUOTA_LIMIT=5
CHAT_QUOTA_WINDOW_HOURS=12
