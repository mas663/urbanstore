# ─────────────────────────────────────────────
# UrbanStore — Environment Variables
# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit file .env ke Git.
# Di Vercel: isi variabel yang sama di Project → Settings → Environment Variables.
# ─────────────────────────────────────────────

# ── Supabase ─────────────────────────────────
# Supabase Dashboard → Project Settings → API Keys
# VITE_ = boleh dibaca browser (aman karena data dilindungi Row Level Security)
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# HANYA untuk server (Vercel Function /api) — dipakai menghitung kuota chat AI.
# JANGAN pernah diberi prefix VITE_ dan jangan ditaruh di kode frontend.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Rekening transfer manual (tampil di halaman pesanan & invoice PDF) ──
VITE_STORE_BANK_NAME=BCA
VITE_STORE_BANK_ACCOUNT=123-456-7890
VITE_STORE_BANK_HOLDER=PT UrbanStore Fashion Indonesia

# ── AI (Sesi 5) — hanya dibaca server ───────
# Pilih provider: gemini | openai_compatible (mis. 9Router)
AI_PROVIDER=gemini

# Ambil API key di https://aistudio.google.com → Get API key
#   GEMINI_API_KEY_CUSTOMER → key "urbanstore-customer" (AI Shopping Assistant)
#   GEMINI_API_KEY_ADMIN    → key "urbanstore-admin"    (AI Deskripsi & Analisis Penjualan)
GEMINI_API_KEY_CUSTOMER=
GEMINI_API_KEY_ADMIN=
# (Opsional) key cadangan, dipakai jika salah satu key di atas kosong
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Model cadangan otomatis saat model utama overload / rate limit (503/429)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Dipakai hanya jika AI_PROVIDER=openai_compatible (mis. 9Router)
AI_BASE_URL=
AI_API_KEY_CUSTOMER=
AI_API_KEY_ADMIN=
AI_API_KEY=
AI_MODEL=

# Batas pemakaian AI Shopping Assistant per customer
CHAT_QUOTA_LIMIT=5
CHAT_QUOTA_WINDOW_HOURS=12

# Port server AI lokal (npm run dev)
PORT=3001
