{
  "name": "urbanstore",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "UrbanStore — online fashion store Gen Z (Vibe Coding Bootcamp Batch 4 · CODEPOLITAN)",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --test \"tests/*.test.js\"",
    "docs:prd": "node scripts/build-prd-html.mjs",
    "images": "node scripts/generate-product-images.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^4.3.5",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
